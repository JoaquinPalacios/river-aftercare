{
  "name": "river-aftercare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x",
    "pnpm": "^12.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:generate && eslint && tsc -b && node scripts/vercel-production-schema-gate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "release:check": "node scripts/release-check.mjs",
    "stripe:config:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stripe-config-check.mjs",
    "observability:test-error": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/observability-test-error.mjs",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:format": "prisma format --config prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:reset": "prisma migrate reset --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "prod:db:status": "node scripts/prod-db.mjs status",
    "prod:db:migrate": "node scripts/prod-db.mjs migrate",
    "prod:db:verify": "node scripts/prod-db.mjs verify",
    "audit:account-split-branding": "prisma generate --config prisma.config.ts && node scripts/audit-account-split-branding-ownership.mjs",
    "prod:audit:account-split-branding": "node scripts/prod-audit-account-split-branding.mjs",
    "bootstrap:demo-template": "node scripts/bootstrap-demo-template.mjs",
    "configure:shared-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/configure-shared-demo.mjs",
    "provision:physio-demo-clinic": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/provision-physio-demo-clinic.mjs",
    "canonical-template:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-canonical-template.mjs",
    "db:studio": "prisma studio --config prisma.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "11.12.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "dompurify": "3.4.17",
    "jsdom": "26.1.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.38.1",
    "stripe": "23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jsdom": "21.1.7",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
