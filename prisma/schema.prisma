generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClinicMembershipRole {
  ADMIN
  STAFF
}

enum Specialty {
  DENTAL
}

enum GuideRevisionStatus {
  DRAFT
  PUBLISHED
}

enum PracticeGuideStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum GuideSectionKind {
  INTRODUCTION
  IMMEDIATE_CARE
  FIRST_24_HOURS
  RECOVERY_TIMELINE
  WHAT_IS_NORMAL
  PAIN
  RESTRICTIONS
  MEDICATIONS
  SITE_CARE
  WHAT_TO_AVOID
  WARNING_SIGNS
  CONTACT_PRACTICE
  EMERGENCY
  CUSTOM
}

enum ClinicRadiusPreset {
  SHARP
  MEDIUM
  SOFT
}

enum ClinicInstructionTerminology {
  AFTERCARE
  POST_TREATMENT
  POST_PROCEDURE
  POST_OPERATIVE
  RECOVERY
}

enum ClinicThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum ClinicTypeface {
  OPEN_SANS
  ROBOTO
  MONTSERRAT
  LATO
  POPPINS
  INTER
}

enum PlatformRole {
  NONE
  OPERATOR
}

enum AccountTokenType {
  INVITATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum PracticeSectionProvenance {
  CANONICAL
  PRACTICE_OVERRIDE
  PRACTICE_ADDITION
  PRACTICE_CUSTOM
}

model Clinic {
  id                   String                      @id @default(cuid())
  name                 String
  slug                 String                      @unique
  memberships          ClinicMembership[]
  profile              ClinicProfile?
  billingProfile       ClinicBillingProfile?
  entitlement          ClinicEntitlement?
  legalAcceptances     LegalAcceptance[]
  practiceGuides       PracticeGuide[]
  accountTokens        AccountToken[]
  downgradePreparation ClinicDowngradePreparation?
  sites                ClinicSite[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
}

model User {
  id                             String                       @id @default(cuid())
  name                           String?
  email                          String                       @unique
  emailVerified                  DateTime?
  image                          String?
  passwordHash                   String?
  platformRole                   PlatformRole                 @default(NONE)
  memberships                    ClinicMembership[]
  accounts                       Account[]
  sessions                       Session[]
  authoredPracticeGuideRevisions PracticeGuideRevision[]      @relation("PracticeGuideRevisionAuthor")
  attestedPracticeGuideRevisions PracticeGuideRevision[]      @relation("PracticeGuideRevisionAttestation")
  accountTokens                  AccountToken[]               @relation("AccountTokenSubject")
  invitedAccountTokens           AccountToken[]               @relation("AccountTokenInviter")
  legalAcceptances               LegalAcceptance[]
  confirmedDowngradePreparations ClinicDowngradePreparation[] @relation("DowngradeSelectionConfirmedBy")
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
}

model ClinicMembership {
  id        String               @id @default(cuid())
  clinicId  String
  userId    String
  role      ClinicMembershipRole
  /// Per-clinic access flag. Inactive memberships do not grant clinic
  /// authorization. This is not a global User disablement.
  active    Boolean              @default(true)
  clinic    Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([clinicId, userId])
  @@index([userId])
  @@index([userId, active])
  @@index([clinicId, role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

/// Account lifecycle tokens (invitations, password reset, email change).
/// Auth.js `VerificationToken` is unused and is not suitable for these flows.
/// Raw tokens are never persisted; only SHA-256(`tokenHash`) is stored.
/// Outstanding uniqueness is a service transaction plus SQL partial unique
/// indexes in the additive migration (Prisma cannot express those predicates).
model AccountToken {
  id              String                @id @default(cuid())
  type            AccountTokenType
  tokenHash       String                @unique
  userId          String
  clinicId        String?
  role            ClinicMembershipRole?
  email           String
  invitedByUserId String?
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime              @default(now())

  user      User    @relation("AccountTokenSubject", fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("AccountTokenInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([clinicId])
  @@index([invitedByUserId])
}

/// Patient-facing practice chrome. Colour, radius, terminology, typeface, and theme-policy fields are validated and mapped to semantic tokens. Never add arbitrary CSS injection fields (customCss, stylesheet, headerHtml).
model ClinicProfile {
  clinicId                 String                       @id
  displayName              String
  /// Stored logo reference: a same-origin demo/static path or a provider-independent object key (`clinics/<clinicId>/branding/<uuid>.<ext>`). Never a Cloudflare, Supabase, or other provider URL. Resolve at read time with `resolveClinicLogoSrc`.
  logoUrl                  String?
  /// Optional Dark-mode mark. Same storage contract as `logoUrl`. Used only when the resolved patient appearance is Dark; otherwise the standard logo is used.
  darkLogoUrl              String?
  /// Optional patient-guide favicon. Same clinic branding object-key contract as `logoUrl`. PNG only. Resolve with `resolveClinicLogoSrc`.
  faviconUrl               String?
  primaryColor             String?
  accentColor              String?
  /// Optional Dark-mode brand colour. Ignored unless `useCustomDarkBranding` is true and `darkAccentColor` is also valid.
  darkPrimaryColor         String?
  /// Optional Dark-mode accent colour. Ignored unless `useCustomDarkBranding` is true and `darkPrimaryColor` is also valid.
  darkAccentColor          String?
  /// When false, Dark patient pages keep using `primaryColor` / `accentColor` with River Aftercare dark surfaces. Does not force patients into Dark appearance.
  useCustomDarkBranding    Boolean                      @default(false)
  neutralColor             String?
  radiusPreset             ClinicRadiusPreset           @default(MEDIUM)
  typeface                 ClinicTypeface?
  instructionTerminology   ClinicInstructionTerminology @default(AFTERCARE)
  themeMode                ClinicThemeMode              @default(SYSTEM)
  allowPatientThemeToggle  Boolean                      @default(false)
  phone                    String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  region                   String?
  postalCode               String?
  country                  String?
  bookingUrl               String?
  contactUrl               String?
  contactEmail             String?
  emergencyInstructions    String?
  showCareGuideAttribution Boolean                      @default(true)
  clinic                   Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
}

/// Public clinic identity belonging to a Clinic account.
/// Owns the tenant hostname and branding. `slug` is globally unique and is
/// the public tenant identity. `Clinic.slug` remains for compatibility.
/// Branding columns are the patient and practice-settings read source.
/// Matching ClinicProfile branding is kept in sync for rollback.
/// Billing, legal, and team stay on Clinic.
/// PostgreSQL enforces slug format and at most one primary site per account.
/// That predicate is in the migration because Prisma cannot express it.
model ClinicSite {
  id                       String                       @id @default(cuid())
  clinicId                 String
  name                     String
  slug                     String                       @unique
  displayName              String
  active                   Boolean                      @default(true)
  /// The account's primary public site. Independent of which location serves
  /// that site's unprefixed patient URLs.
  isPrimary                Boolean                      @default(false)
  logoUrl                  String?
  darkLogoUrl              String?
  faviconUrl               String?
  primaryColor             String?
  accentColor              String?
  darkPrimaryColor         String?
  darkAccentColor          String?
  useCustomDarkBranding    Boolean                      @default(false)
  neutralColor             String?
  radiusPreset             ClinicRadiusPreset           @default(MEDIUM)
  typeface                 ClinicTypeface?
  instructionTerminology   ClinicInstructionTerminology @default(AFTERCARE)
  themeMode                ClinicThemeMode              @default(SYSTEM)
  allowPatientThemeToggle  Boolean                      @default(false)
  showCareGuideAttribution Boolean                      @default(true)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  clinic                   Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  locations                ClinicLocation[]

  @@unique([id, clinicId])
  @@index([clinicId])
}

/// Physical practice belonging to a ClinicSite.
/// Contact and emergency fields are the patient and practice-settings read
/// source. Matching ClinicProfile contact fields are kept in sync for
/// rollback. Branding is not stored here.
/// `slug` is null for the location that serves unprefixed site-root patient
/// URLs. A non-root location requires a slug unique within the site.
/// `clinicId` matches the parent site so a location cannot attach to another
/// account's site. PostgreSQL enforces the root/slug pairing and at most one
/// primary and one site-root location per site. Those predicates are in the
/// migration because Prisma cannot express them.
model ClinicLocation {
  id                    String                       @id @default(cuid())
  clinicSiteId          String
  clinicId              String
  /// Staff-facing place name.
  name                  String
  /// Path segment under the site hostname. Null means this location has no
  /// path segment and is served on the site hostname root.
  slug                  String?
  /// Patient-facing place name.
  displayName           String
  phone                 String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  region                String?
  postalCode            String?
  country               String?
  contactUrl            String?
  contactEmail          String?
  bookingUrl            String?
  emergencyInstructions String?
  /// The site's primary/default physical location. Independent of
  /// `servesSiteRoot`, so a later default can change without moving historic
  /// unprefixed patient URLs.
  isPrimary             Boolean                      @default(false)
  /// The location permanently associated with existing unprefixed patient URLs
  /// on this site's hostname.
  servesSiteRoot        Boolean                      @default(false)
  active                Boolean                      @default(true)
  deactivatedAt         DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  clinicSite            ClinicSite                   @relation(fields: [clinicSiteId, clinicId], references: [id, clinicId], onDelete: Cascade)
  placements            PracticeGuidePlacement[]
  downgradeSelections   DowngradeLocationSelection[]

  @@unique([clinicSiteId, slug])
  @@unique([id, clinicId])
  @@index([clinicSiteId])
  @@index([clinicId])
}

model GuideTemplate {
  id                    String                  @id @default(cuid())
  specialty             Specialty
  slug                  String                  @unique
  title                 String
  isActive              Boolean                 @default(true)
  /// Sample/demo library content. Never eligible for ordinary real-clinic
  /// enablement, even if revision review metadata is later populated.
  /// Distinct from clinic publish attestation on PracticeGuideRevision.
  isSample              Boolean                 @default(false)
  revisions             GuideTemplateRevision[]
  practiceGuides        PracticeGuide[]
  sourcedPracticeGuides PracticeGuide[]         @relation("PracticeGuideSourceTemplate")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([specialty, isActive])
}

model GuideTemplateRevision {
  id              String                 @id @default(cuid())
  guideTemplateId String
  version         Int
  status          GuideRevisionStatus    @default(DRAFT)
  reviewedAt      DateTime?
  reviewedBy      String?
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  guideTemplate   GuideTemplate          @relation(fields: [guideTemplateId], references: [id], onDelete: Cascade)
  sections        GuideTemplateSection[]
  practiceGuides  PracticeGuide[]

  @@unique([guideTemplateId, version])
  @@unique([id, guideTemplateId])
  @@index([guideTemplateId, status])
}

model GuideTemplateSection {
  id          String                @id @default(cuid())
  revisionId  String
  key         String
  kind        GuideSectionKind
  title       String
  body        String                @db.Text
  periodLabel String?
  startDay    Int?
  endDay      Int?
  sortOrder   Int
  revision    GuideTemplateRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([revisionId, key])
  @@unique([revisionId, sortOrder])
  @@index([revisionId])
}

/// A practice-enabled canonical or custom guide. Template-backed guides keep
/// `guideTemplateId` plus a canonical `pinnedRevisionId` (ADR 0010). Custom
/// guides leave both null. Patient-visible content is served from an immutable
/// published `PracticeGuideRevision` snapshot, not from live overrides.
model PracticeGuide {
  id                        String                    @id @default(cuid())
  clinicId                  String
  title                     String
  guideTemplateId           String?
  pinnedRevisionId          String?
  /// Set when this row is forked from a River template into a clinic-owned
  /// editable copy. Provenance only: it does not keep the canonical pin.
  /// Existing rows stay null. Production has no historical adaptations to backfill.
  adaptedAt                 DateTime?
  /// Canonical River template this copy came from. Counts toward the
  /// adapted-template allowance, not the original custom-guide allowance.
  /// Null for original custom guides and for templates still used as supplied.
  sourceGuideTemplateId     String?
  /// Set when this account-owned guide is a detached copy of another
  /// account-owned guide. Provenance only. Existing rows stay null.
  /// Do not infer this from a template relationship.
  copiedFromPracticeGuideId String?
  publicSlug                String
  isEnabled                 Boolean                   @default(false)
  status                    PracticeGuideStatus       @default(DRAFT)
  sortOrder                 Int                       @default(0)
  publishedAt               DateTime?
  /// Set when this clinic-owned guide enters 60-day downgrade retention.
  /// Null means the guide is active. Publication status is unchanged.
  downgradeRetainedAt       DateTime?
  /// First effective Practice → Essential transition plus 60 UTC days.
  /// Not moved by a replayed webhook. Null when the guide is active.
  downgradeRetentionUntil   DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  clinic                    Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  guideTemplate             GuideTemplate?            @relation(fields: [guideTemplateId], references: [id], onDelete: Restrict)
  pinnedRevision            GuideTemplateRevision?    @relation(fields: [pinnedRevisionId, guideTemplateId], references: [id, guideTemplateId], onDelete: Restrict)
  sourceGuideTemplate       GuideTemplate?            @relation("PracticeGuideSourceTemplate", fields: [sourceGuideTemplateId], references: [id], onDelete: SetNull)
  copiedFromPracticeGuide   PracticeGuide?            @relation("PracticeGuideCopyProvenance", fields: [copiedFromPracticeGuideId], references: [id], onDelete: SetNull)
  detachedCopies            PracticeGuide[]           @relation("PracticeGuideCopyProvenance")
  overrides                 PracticeGuideOverride[]
  additions                 PracticeGuideAddition[]
  contentRevisions          PracticeGuideRevision[]
  downgradeSelections       DowngradeGuideSelection[]
  placements                PracticeGuidePlacement[]

  @@unique([id, clinicId])
  @@unique([clinicId, guideTemplateId])
  @@unique([clinicId, publicSlug])
  @@index([clinicId, status, isEnabled])
  @@index([clinicId, downgradeRetainedAt])
  @@index([guideTemplateId])
  @@index([pinnedRevisionId])
  @@index([sourceGuideTemplateId])
  @@index([copiedFromPracticeGuideId])
}

/// Clinic-owned guide document. Version 0 is the mutable working draft.
/// Versions 1+ are immutable published snapshots. Public pages pin the
/// highest published version; draft edits never mutate those rows.
model PracticeGuideRevision {
  id                     String                         @id @default(cuid())
  practiceGuideId        String
  version                Int
  status                 GuideRevisionStatus            @default(DRAFT)
  title                  String
  introduction           String?                        @db.Text
  publishedAt            DateTime?
  createdByUserId        String?
  /// Practice confirmation that this clinic approved the snapshot for
  /// patients. Not River Aftercare clinical approval. The attesting user is
  /// the Clinic ADMIN who confirmed the practice's review process — not
  /// necessarily the clinician who performed that review.
  reviewAttestedAt       DateTime?
  reviewAttestedByUserId String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  practiceGuide          PracticeGuide                  @relation(fields: [practiceGuideId], references: [id], onDelete: Cascade)
  createdBy              User?                          @relation("PracticeGuideRevisionAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewAttestedBy       User?                          @relation("PracticeGuideRevisionAttestation", fields: [reviewAttestedByUserId], references: [id], onDelete: SetNull)
  sections               PracticeGuideRevisionSection[]
  placements             PracticeGuidePlacement[]

  @@unique([practiceGuideId, version])
  @@index([practiceGuideId, status])
  @@index([createdByUserId])
  @@index([reviewAttestedByUserId])
}

model PracticeGuideRevisionSection {
  id          String                    @id @default(cuid())
  revisionId  String
  key         String
  kind        GuideSectionKind
  title       String
  body        String                    @db.Text
  periodLabel String?
  startDay    Int?
  endDay      Int?
  sortOrder   Int
  provenance  PracticeSectionProvenance
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  revision    PracticeGuideRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, key])
  @@unique([revisionId, sortOrder])
  @@index([revisionId])
}

/// Account-owned guide offered at one physical location.
/// `clinicId` is shared by the guide and location foreign keys, so both sides
/// belong to the same Clinic account. Patient pages resolve guides through
/// the root location's enabled placement.
/// `publishedPracticeGuideRevisionId` points at a clinic-owned
/// PracticeGuideRevision. It is null when patients are still served from the
/// canonical template pin, or when the guide is not currently published.
/// It is not PracticeGuide.pinnedRevisionId, which references GuideTemplateRevision.
model PracticeGuidePlacement {
  id                               String                 @id @default(cuid())
  practiceGuideId                  String
  locationId                       String
  clinicId                         String
  publishedPracticeGuideRevisionId String?
  publicSlug                       String
  isEnabled                        Boolean                @default(false)
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt
  practiceGuide                    PracticeGuide          @relation(fields: [practiceGuideId, clinicId], references: [id, clinicId], onDelete: Cascade)
  location                         ClinicLocation         @relation(fields: [locationId, clinicId], references: [id, clinicId], onDelete: Cascade)
  publishedPracticeGuideRevision   PracticeGuideRevision? @relation(fields: [publishedPracticeGuideRevisionId], references: [id], onDelete: SetNull)

  @@unique([locationId, practiceGuideId])
  @@unique([locationId, publicSlug])
  @@index([practiceGuideId])
  @@index([clinicId])
  @@index([publishedPracticeGuideRevisionId])
}

model PracticeGuideOverride {
  id              String        @id @default(cuid())
  practiceGuideId String
  sectionKey      String
  title           String
  body            String        @db.Text
  practiceGuide   PracticeGuide @relation(fields: [practiceGuideId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([practiceGuideId, sectionKey])
  @@index([practiceGuideId])
}

model PracticeGuideAddition {
  id                    String           @id @default(cuid())
  practiceGuideId       String
  key                   String
  kind                  GuideSectionKind
  title                 String
  body                  String           @db.Text
  periodLabel           String?
  startDay              Int?
  endDay                Int?
  sortOrder             Int
  insertAfterSectionKey String?
  practiceGuide         PracticeGuide    @relation(fields: [practiceGuideId], references: [id], onDelete: Cascade)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([practiceGuideId, key])
  @@index([practiceGuideId])
}

/// Singleton platform identity for public marketing metadata and generated JSON-LD.
/// Canonical URLs are derived from the production origin + route, never stored here.
/// Future clinic-guide searchVisibility stays off this model (see docs/architecture/SEO.md).
model PlatformSeoSettings {
  id                      String   @id @default("platform")
  siteName                String
  defaultDescription      String
  organizationName        String
  organizationDescription String
  publicContactEmail      String?
  defaultOgImagePath      String?
  sameAsUrls              String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// Per-route marketing metadata. Operators edit content fields, not routing truth.
model MarketingPageSeo {
  id              String   @id @default(cuid())
  path            String   @unique
  seoTitle        String
  metaDescription String
  ogTitle         String?
  ogDescription   String?
  ogImagePath     String?
  index           Boolean  @default(true)
  follow          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum CommercialPlan {
  ESSENTIAL
  PRACTICE
  GROUP
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

/// Stripe-facing commercial/payment lifecycle. Not a copy of every Stripe
/// subscription.status, and not product authorization.
enum BillingStatus {
  /// Operator prepared a standard offer. Checkout has not been submitted.
  OFFER_PREPARED
  PAYMENT_PENDING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCEL_AT_PERIOD_END
  ENDED
}

/// River product authorization derived from billing.
/// PENDING is the Phase 2 pre-payment activation gate for clinics explicitly
/// placed into billing onboarding. RESTRICTED and ENDED are not enforced yet.
enum EntitlementStatus {
  PENDING
  ACTIVE
  RESTRICTED
  ENDED
}

/// Why a person accepted the current legal documents. Append-only.
enum LegalAcceptanceSource {
  BILLING_CHECKOUT
}

enum StripeEventProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// One current Practice → Essential preparation per clinic.
/// This is not the Stripe schedule. Scheduling stays on ClinicEntitlement.
enum DowngradePreparationStatus {
  AWAITING_SELECTION
  SELECTION_CONFIRMED
}

/// Local preparation for a Practice → Essential downgrade.
/// At most one row per clinic. Selected guides are child rows, not JSON.
/// Confirming a selection does not call Stripe and does not retain guides.
model ClinicDowngradePreparation {
  id                 String                       @id @default(cuid())
  clinicId           String                       @unique
  targetPlan         CommercialPlan
  status             DowngradePreparationStatus
  confirmedAt        DateTime?
  confirmedByUserId  String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  clinic             Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  confirmedBy        User?                        @relation("DowngradeSelectionConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  selections         DowngradeGuideSelection[]
  locationSelections DowngradeLocationSelection[]

  @@index([confirmedByUserId])
}

/// Clinic-owned guides the clinic administrator chose to keep active.
/// Deleting the guide or the preparation removes the row.
model DowngradeGuideSelection {
  id              String                     @id @default(cuid())
  preparationId   String
  practiceGuideId String
  createdAt       DateTime                   @default(now())
  preparation     ClinicDowngradePreparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  practiceGuide   PracticeGuide              @relation(fields: [practiceGuideId], references: [id], onDelete: Cascade)

  @@unique([preparationId, practiceGuideId])
  @@index([practiceGuideId])
}

/// Location the clinic administrator chose to keep active on a future
/// Practice → Essential downgrade. Not read or written by the current
/// downgrade flow.
model DowngradeLocationSelection {
  id            String                     @id @default(cuid())
  preparationId String
  locationId    String
  createdAt     DateTime                   @default(now())
  preparation   ClinicDowngradePreparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  location      ClinicLocation             @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([preparationId, locationId])
  @@index([locationId])
}

/// Legal/billing identity and Stripe Customer/Subscription linkage.
/// Separate from ClinicProfile (patient-facing chrome). Existing clinics are
/// not backfilled; rows are created when billing data exists.
model ClinicBillingProfile {
  id                           String   @id @default(cuid())
  clinicId                     String   @unique
  legalEntityName              String?
  tradingName                  String?
  billingContactName           String?
  billingEmail                 String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  region                       String?
  postalCode                   String?
  country                      String?  @default("AU")
  /// Australian Business Number. Nullable until captured. Not a combined
  /// business-number field; ACN is stored separately.
  abn                          String?
  /// Australian Company Number. Used when the customer has no ABN.
  acn                          String?
  stripeCustomerId             String?  @unique
  stripeSubscriptionId         String?  @unique
  /// River-managed Subscription Schedule for a Practice → Essential change
  /// at the next renewal. Opaque Stripe id. Not a second subscription.
  /// Null when no downgrade is scheduled. Multiple nulls are allowed.
  stripeSubscriptionScheduleId String?  @unique
  /// One Practice → Essential scheduling lifecycle. Stable across retries of
  /// that attempt, including a create that succeeded before the update was
  /// confirmed. Cleared when that lifecycle ends. Not a Stripe id and not
  /// shown to customers. Multiple nulls are allowed.
  stripePlanDowngradeAttemptId String?  @unique
  /// Latest hosted Checkout Session, so a repeated click can reuse it.
  /// Cleared when the operator changes the offer. Not a payment credential.
  stripeCheckoutSessionId      String?  @unique
  clinic                       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

/// Local entitlement projection.
/// No row: legacy clinic. Product access stays as it is today.
/// PENDING: Phase 2 pre-payment gate for a clinic prepared for paid onboarding.
/// ACTIVE: product access is open.
/// RESTRICTED / ENDED: preserved for a later enforcement phase. Not a lockout.
model ClinicEntitlement {
  id                               String            @id @default(cuid())
  clinicId                         String            @unique
  commercialPlan                   CommercialPlan?
  billingInterval                  BillingInterval?
  billingStatus                    BillingStatus
  entitlementStatus                EntitlementStatus
  stripePriceId                    String?
  currentPeriodStart               DateTime?
  currentPeriodEnd                 DateTime?
  paidThrough                      DateTime?
  cancelAtPeriodEnd                Boolean           @default(false)
  subscriptionEndedAt              DateTime?
  /// Calculated only when a subscription actually ends. Not set on
  /// cancel-at-period-end while the period is still paid.
  publicGuideRetentionUntil        DateTime?
  lastStripeEventId                String?
  lastProjectedAt                  DateTime?
  /// Persistent operator-granted additions. Effective allowance is the plan
  /// base plus these values. They do not change Stripe or commercialPlan.
  extraTeamMemberAllowance         Int               @default(0)
  extraCustomGuideAllowance        Int               @default(0)
  extraTemplateAdaptationAllowance Int               @default(0)
  /// Total ClinicSite capacity for this account, including the included site.
  /// Existing rows default to 1 (Essential-compatible). Group totals are
  /// operator-configured later. Not enforced yet. Does not change Stripe.
  /// A missing entitlement row does not grant unlimited sites.
  siteAllowance                    Int               @default(1)
  /// Total active ClinicLocation capacity for this account, across every site.
  /// Existing rows default to 1 (Essential-compatible). Not a per-site cap.
  /// Not enforced yet. Does not change Stripe.
  /// A missing entitlement row does not grant unlimited locations.
  locationAllowance                Int               @default(1)
  /// Scheduled plan. Null when nothing is scheduled. commercialPlan stays
  /// the current plan until a trusted Stripe event shows the new Price.
  scheduledCommercialPlan          CommercialPlan?
  /// When scheduledCommercialPlan becomes effective. The current paid-period
  /// end. Not a cancellation date.
  scheduledPlanEffectiveAt         DateTime?
  clinic                           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @updatedAt

  @@index([billingStatus])
  @@index([entitlementStatus])
}

/// Immutable Terms acceptance and Privacy acknowledgement.
/// A later document version inserts a new row. Existing rows are not rewritten.
/// No IP address or device fingerprint is stored.
model LegalAcceptance {
  id                         String                @id @default(cuid())
  clinicId                   String
  userId                     String
  termsVersion               String
  privacyVersionAcknowledged String
  source                     LegalAcceptanceSource
  acceptedAt                 DateTime              @default(now())
  createdAt                  DateTime              @default(now())
  clinic                     Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user                       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clinicId, acceptedAt])
  @@index([userId])
}

/// Idempotency and processing metadata for verified Stripe webhook events.
/// The Stripe event payload is not stored.
model StripeEventReceipt {
  id               String                      @id @default(cuid())
  stripeEventId    String                      @unique
  eventType        String
  stripeCreatedAt  DateTime?
  receivedAt       DateTime                    @default(now())
  processedAt      DateTime?
  processingStatus StripeEventProcessingStatus @default(RECEIVED)
  failureText      String?
  clinicId         String?

  @@index([eventType, receivedAt])
  @@index([processingStatus])
  @@index([clinicId])
}
