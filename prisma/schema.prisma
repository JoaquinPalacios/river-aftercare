generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClinicMembershipRole {
  ADMIN
  STAFF
}

enum ProcedureSessionStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

/// Display mode for the patient-facing view of a live session.
/// CALM     -> ProcedureStageTemplate.calmCopy
/// STANDARD -> ProcedureStageTemplate.patientCopy
/// DETAILED -> ProcedureStageTemplate.detailedCopy
enum PatientDisplayMode {
  CALM
  STANDARD
  DETAILED
}

enum ProcedureSessionStageTransitionDirection {
  NEXT
  PREVIOUS
}

enum Specialty {
  DENTAL
}

enum GuideRevisionStatus {
  DRAFT
  PUBLISHED
}

enum PracticeGuideStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum GuideSectionKind {
  INTRODUCTION
  IMMEDIATE_CARE
  FIRST_24_HOURS
  RECOVERY_TIMELINE
  WHAT_IS_NORMAL
  PAIN
  RESTRICTIONS
  MEDICATIONS
  SITE_CARE
  WHAT_TO_AVOID
  WARNING_SIGNS
  CONTACT_PRACTICE
  EMERGENCY
  CUSTOM
}

enum ClinicRadiusPreset {
  SHARP
  MEDIUM
  SOFT
}

enum ClinicInstructionTerminology {
  AFTERCARE
  POST_TREATMENT
  POST_PROCEDURE
  POST_OPERATIVE
  RECOVERY
}

enum ClinicThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum ClinicTypeface {
  OPEN_SANS
  ROBOTO
  MONTSERRAT
  LATO
  POPPINS
  INTER
}

enum PlatformRole {
  NONE
  OPERATOR
}

enum AccountTokenType {
  INVITATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum PracticeSectionProvenance {
  CANONICAL
  PRACTICE_OVERRIDE
  PRACTICE_ADDITION
  PRACTICE_CUSTOM
}

model Clinic {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  memberships        ClinicMembership[]
  procedureTemplates ProcedureTemplate[]
  rooms              Room[]
  doctors            Doctor[]
  procedureSessions  ProcedureSession[]
  profile            ClinicProfile?
  practiceGuides     PracticeGuide[]
  accountTokens      AccountToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model User {
  id                              String                     @id @default(cuid())
  name                            String?
  email                           String                     @unique
  emailVerified                   DateTime?
  image                           String?
  passwordHash                    String?
  platformRole                    PlatformRole               @default(NONE)
  memberships                     ClinicMembership[]
  accounts                        Account[]
  sessions                        Session[]
  authoredPracticeGuideRevisions  PracticeGuideRevision[]    @relation("PracticeGuideRevisionAuthor")
  attestedPracticeGuideRevisions  PracticeGuideRevision[]    @relation("PracticeGuideRevisionAttestation")
  accountTokens                   AccountToken[]             @relation("AccountTokenSubject")
  invitedAccountTokens            AccountToken[]             @relation("AccountTokenInviter")
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
}

model ClinicMembership {
  id        String               @id @default(cuid())
  clinicId  String
  userId    String
  role      ClinicMembershipRole
  /// Per-clinic access flag. Inactive memberships do not grant clinic
  /// authorization. This is not a global User disablement.
  active    Boolean              @default(true)
  clinic    Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([clinicId, userId])
  @@index([userId])
  @@index([userId, active])
  @@index([clinicId, role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

/// Account lifecycle tokens (invitations, password reset, email change).
/// Auth.js `VerificationToken` is unused and is not suitable for these flows.
/// Raw tokens are never persisted; only SHA-256(`tokenHash`) is stored.
/// Outstanding uniqueness is a service transaction plus SQL partial unique
/// indexes in the additive migration (Prisma cannot express those predicates).
model AccountToken {
  id              String                @id @default(cuid())
  type            AccountTokenType
  tokenHash       String                @unique
  userId          String
  clinicId        String?
  role            ClinicMembershipRole?
  email           String
  invitedByUserId String?
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime              @default(now())

  user      User    @relation("AccountTokenSubject", fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("AccountTokenInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([clinicId])
  @@index([invitedByUserId])
}

model ProcedureTemplate {
  id                  String                                @id @default(cuid())
  clinicId            String
  name                String
  slug                String
  isActive            Boolean                               @default(true)
  aftercareUrl        String?
  clinic              Clinic                                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  stageTemplates      ProcedureStageTemplate[]
  selectedAreaOptions ProcedureTemplateSelectedAreaOption[]
  sessions            ProcedureSession[]
  createdAt           DateTime                              @default(now())
  updatedAt           DateTime                              @updatedAt

  @@unique([clinicId, slug])
  @@index([clinicId, isActive])
}

model ProcedureStageTemplate {
  id                     String                          @id @default(cuid())
  procedureTemplateId    String
  stageOrder             Int
  title                  String
  calmCopy               String
  patientCopy            String
  detailedCopy           String
  illustrationUrl        String?
  defaultDurationHint    String?
  procedureTemplate      ProcedureTemplate               @relation(fields: [procedureTemplateId], references: [id], onDelete: Cascade)
  currentInSessionStates SessionStageState[]
  sessionOverrides       ProcedureSessionStageOverride[]
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  @@unique([procedureTemplateId, stageOrder])
  @@index([procedureTemplateId])
}

model ProcedureTemplateSelectedAreaOption {
  id                  String             @id @default(cuid())
  procedureTemplateId String
  key                 String
  label               String
  sortOrder           Int
  isActive            Boolean            @default(true)
  procedureTemplate   ProcedureTemplate  @relation(fields: [procedureTemplateId], references: [id], onDelete: Cascade)
  sessions            ProcedureSession[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([procedureTemplateId, key])
  @@unique([procedureTemplateId, sortOrder])
  @@index([procedureTemplateId, isActive])
}

model Room {
  id        String             @id @default(cuid())
  clinicId  String
  name      String
  slug      String
  isActive  Boolean            @default(true)
  clinic    Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sessions  ProcedureSession[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([clinicId, slug])
  @@index([clinicId, isActive])
}

model Doctor {
  id        String             @id @default(cuid())
  clinicId  String
  name      String
  slug      String
  isActive  Boolean            @default(true)
  clinic    Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sessions  ProcedureSession[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([clinicId, slug])
  @@index([clinicId, isActive])
}

model ProcedureSession {
  id                   String                 @id @default(cuid())
  clinicId             String
  roomId               String
  doctorId             String
  procedureTemplateId  String
  selectedAreaOptionId String?
  status               ProcedureSessionStatus @default(DRAFT)
  displayToken         String                 @unique
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  clinic             Clinic                               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  room               Room                                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  doctor             Doctor                               @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  procedureTemplate  ProcedureTemplate                    @relation(fields: [procedureTemplateId], references: [id], onDelete: Restrict)
  selectedAreaOption ProcedureTemplateSelectedAreaOption? @relation(fields: [selectedAreaOptionId], references: [id], onDelete: SetNull)
  stageState         SessionStageState?
  displayPreferences PatientDisplayPreferences?
  stageOverrides     ProcedureSessionStageOverride[]
  stageTransitions   ProcedureSessionStageTransition[]

  @@index([clinicId, status])
  @@index([roomId, status])
  @@index([doctorId])
  @@index([procedureTemplateId])
  @@index([selectedAreaOptionId])
}

model SessionStageState {
  id                     String    @id @default(cuid())
  procedureSessionId     String    @unique
  currentStageTemplateId String?
  currentStageStartedAt  DateTime?
  initializedAt          DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  procedureSession     ProcedureSession        @relation(fields: [procedureSessionId], references: [id], onDelete: Cascade)
  currentStageTemplate ProcedureStageTemplate? @relation(fields: [currentStageTemplateId], references: [id], onDelete: SetNull)

  @@index([currentStageTemplateId])
}

model PatientDisplayPreferences {
  id                 String             @id @default(cuid())
  procedureSessionId String             @unique
  mode               PatientDisplayMode @default(STANDARD)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  procedureSession ProcedureSession @relation(fields: [procedureSessionId], references: [id], onDelete: Cascade)
}

model ProcedureSessionStageOverride {
  id                       String   @id @default(cuid())
  procedureSessionId       String
  procedureStageTemplateId String
  title                    String?
  calmCopy                 String?
  patientCopy              String?
  detailedCopy             String?
  durationHint             String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  procedureSession       ProcedureSession       @relation(fields: [procedureSessionId], references: [id], onDelete: Cascade)
  procedureStageTemplate ProcedureStageTemplate @relation(fields: [procedureStageTemplateId], references: [id], onDelete: Cascade)

  @@unique([procedureSessionId, procedureStageTemplateId])
  @@index([procedureStageTemplateId])
}

model ProcedureSessionStageTransition {
  id                  String                                   @id @default(cuid())
  procedureSessionId  String
  direction           ProcedureSessionStageTransitionDirection
  fromStageTemplateId String?
  toStageTemplateId   String
  actorUserId         String?
  occurredAt          DateTime                                 @default(now())

  procedureSession ProcedureSession @relation(fields: [procedureSessionId], references: [id], onDelete: Cascade)

  @@index([procedureSessionId, occurredAt])
}

/// Patient-facing practice chrome. Colour, radius, terminology, typeface, and theme-policy fields are validated and mapped to semantic tokens. Never add arbitrary CSS injection fields (customCss, stylesheet, headerHtml).
model ClinicProfile {
  clinicId                 String                       @id
  displayName              String
  /// Stored logo reference: a same-origin demo/static path or a provider-independent object key (`clinics/<clinicId>/branding/<uuid>.<ext>`). Never a Cloudflare, Supabase, or other provider URL. Resolve at read time with `resolveClinicLogoSrc`.
  logoUrl                  String?
  /// Optional Dark-mode mark. Same storage contract as `logoUrl`. Used only when the resolved patient appearance is Dark; otherwise the standard logo is used.
  darkLogoUrl              String?
  /// Optional patient-guide favicon. Same clinic branding object-key contract as `logoUrl`. PNG only. Resolve with `resolveClinicLogoSrc`.
  faviconUrl               String?
  primaryColor             String?
  accentColor              String?
  /// Optional Dark-mode brand colour. Ignored unless `useCustomDarkBranding` is true and `darkAccentColor` is also valid.
  darkPrimaryColor         String?
  /// Optional Dark-mode accent colour. Ignored unless `useCustomDarkBranding` is true and `darkPrimaryColor` is also valid.
  darkAccentColor          String?
  /// When false, Dark patient pages keep using `primaryColor` / `accentColor` with River Aftercare dark surfaces. Does not force patients into Dark appearance.
  useCustomDarkBranding    Boolean                      @default(false)
  neutralColor             String?
  radiusPreset             ClinicRadiusPreset           @default(MEDIUM)
  typeface                 ClinicTypeface?
  instructionTerminology   ClinicInstructionTerminology @default(AFTERCARE)
  themeMode                ClinicThemeMode              @default(SYSTEM)
  allowPatientThemeToggle  Boolean                      @default(false)
  phone                    String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  region                   String?
  postalCode               String?
  country                  String?
  bookingUrl               String?
  contactUrl               String?
  contactEmail             String?
  emergencyInstructions    String?
  showCareGuideAttribution Boolean                      @default(true)
  clinic                   Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
}

model GuideTemplate {
  id             String                  @id @default(cuid())
  specialty      Specialty
  slug           String                  @unique
  title          String
  isActive       Boolean                 @default(true)
  /// Sample/demo library content. Never eligible for ordinary real-clinic
  /// enablement, even if revision review metadata is later populated.
  /// Distinct from clinic publish attestation on PracticeGuideRevision.
  isSample       Boolean                 @default(false)
  revisions      GuideTemplateRevision[]
  practiceGuides PracticeGuide[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([specialty, isActive])
}

model GuideTemplateRevision {
  id              String                 @id @default(cuid())
  guideTemplateId String
  version         Int
  status          GuideRevisionStatus    @default(DRAFT)
  reviewedAt      DateTime?
  reviewedBy      String?
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  guideTemplate   GuideTemplate          @relation(fields: [guideTemplateId], references: [id], onDelete: Cascade)
  sections        GuideTemplateSection[]
  practiceGuides  PracticeGuide[]

  @@unique([guideTemplateId, version])
  @@unique([id, guideTemplateId])
  @@index([guideTemplateId, status])
}

model GuideTemplateSection {
  id          String                @id @default(cuid())
  revisionId  String
  key         String
  kind        GuideSectionKind
  title       String
  body        String                @db.Text
  periodLabel String?
  startDay    Int?
  endDay      Int?
  sortOrder   Int
  revision    GuideTemplateRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([revisionId, key])
  @@unique([revisionId, sortOrder])
  @@index([revisionId])
}

/// A practice-enabled canonical or custom guide. Template-backed guides keep
/// `guideTemplateId` plus a canonical `pinnedRevisionId` (ADR 0010). Custom
/// guides leave both null. Patient-visible content is served from an immutable
/// published `PracticeGuideRevision` snapshot, not from live overrides.
model PracticeGuide {
  id               String                    @id @default(cuid())
  clinicId         String
  title            String
  guideTemplateId  String?
  pinnedRevisionId String?
  publicSlug       String
  isEnabled        Boolean                   @default(false)
  status           PracticeGuideStatus       @default(DRAFT)
  sortOrder        Int                       @default(0)
  publishedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  clinic           Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  guideTemplate    GuideTemplate?            @relation(fields: [guideTemplateId], references: [id], onDelete: Restrict)
  pinnedRevision   GuideTemplateRevision?    @relation(fields: [pinnedRevisionId, guideTemplateId], references: [id, guideTemplateId], onDelete: Restrict)
  overrides        PracticeGuideOverride[]
  additions        PracticeGuideAddition[]
  contentRevisions PracticeGuideRevision[]

  @@unique([clinicId, guideTemplateId])
  @@unique([clinicId, publicSlug])
  @@index([clinicId, status, isEnabled])
  @@index([guideTemplateId])
  @@index([pinnedRevisionId])
}

/// Clinic-owned guide document. Version 0 is the mutable working draft.
/// Versions 1+ are immutable published snapshots. Public pages pin the
/// highest published version; draft edits never mutate those rows.
model PracticeGuideRevision {
  id                       String                          @id @default(cuid())
  practiceGuideId          String
  version                  Int
  status                   GuideRevisionStatus             @default(DRAFT)
  title                    String
  introduction             String?                         @db.Text
  publishedAt              DateTime?
  createdByUserId          String?
  /// Practice confirmation that this clinic approved the snapshot for
  /// patients. Not River Aftercare clinical approval. The attesting user is
  /// the Clinic ADMIN who confirmed the practice's review process — not
  /// necessarily the clinician who performed that review.
  reviewAttestedAt         DateTime?
  reviewAttestedByUserId   String?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  practiceGuide            PracticeGuide                   @relation(fields: [practiceGuideId], references: [id], onDelete: Cascade)
  createdBy                User?                           @relation("PracticeGuideRevisionAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewAttestedBy         User?                           @relation("PracticeGuideRevisionAttestation", fields: [reviewAttestedByUserId], references: [id], onDelete: SetNull)
  sections                 PracticeGuideRevisionSection[]

  @@unique([practiceGuideId, version])
  @@index([practiceGuideId, status])
  @@index([createdByUserId])
  @@index([reviewAttestedByUserId])
}

model PracticeGuideRevisionSection {
  id            String                     @id @default(cuid())
  revisionId    String
  key           String
  kind          GuideSectionKind
  title         String
  body          String                     @db.Text
  periodLabel   String?
  startDay      Int?
  endDay        Int?
  sortOrder     Int
  provenance    PracticeSectionProvenance
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  revision      PracticeGuideRevision      @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, key])
  @@unique([revisionId, sortOrder])
  @@index([revisionId])
}

model PracticeGuideOverride {
  id              String        @id @default(cuid())
  practiceGuideId String
  sectionKey      String
  title           String
  body            String        @db.Text
  practiceGuide   PracticeGuide @relation(fields: [practiceGuideId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([practiceGuideId, sectionKey])
  @@index([practiceGuideId])
}

model PracticeGuideAddition {
  id                    String           @id @default(cuid())
  practiceGuideId       String
  key                   String
  kind                  GuideSectionKind
  title                 String
  body                  String           @db.Text
  periodLabel           String?
  startDay              Int?
  endDay                Int?
  sortOrder             Int
  insertAfterSectionKey String?
  practiceGuide         PracticeGuide    @relation(fields: [practiceGuideId], references: [id], onDelete: Cascade)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([practiceGuideId, key])
  @@index([practiceGuideId])
}

/// Singleton platform identity for public marketing metadata and generated JSON-LD.
/// Canonical URLs are derived from the production origin + route, never stored here.
/// Future clinic-guide searchVisibility stays off this model (see docs/architecture/SEO.md).
model PlatformSeoSettings {
  id                      String   @id @default("platform")
  siteName                String
  defaultDescription      String
  organizationName        String
  organizationDescription String
  publicContactEmail      String?
  defaultOgImagePath      String?
  sameAsUrls              String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// Per-route marketing metadata. Operators edit content fields, not routing truth.
model MarketingPageSeo {
  id              String   @id @default(cuid())
  path            String   @unique
  seoTitle        String
  metaDescription String
  ogTitle         String?
  ogDescription   String?
  ogImagePath     String?
  index           Boolean  @default(true)
  follow          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
