# Matches the local PostgreSQL 18 container in compose.yaml (localhost:5432).
# Local `pnpm dev` / `pnpm db:*` use this database. Playwright does not.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/care_guide?schema=public"
# Dedicated Playwright database on the same PostgreSQL 18 server. `pnpm test:e2e`
# creates it if missing, migrates, and seeds it. It must not be the development DB.
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/care_guide_e2e?schema=public"
# Optional. Prisma CLI (migrate / seed / studio) uses DIRECT_URL when set,
# otherwise DATABASE_URL. Local Docker does not need a second URL.
# Production migrations use a local gitignored .env.neon-production file with
# DATABASE_URL (pooled) and DIRECT_URL (unpooled). Never put those secrets here.
# Canonical helpers: pnpm prod:db:status / pnpm prod:db:migrate --apply
# See docs/launch/PRODUCTION-MIGRATION.md.
# DIRECT_URL=
AUTH_SECRET="replace-with-a-long-random-string"

# Platform hostname root used by tenant routing. Local development:
# localhost → marketing homepage, app.localhost → staff, <slug>.localhost → tenant.
# Do not hard-code a commercial production domain here.
CARE_GUIDE_ROOT_DOMAIN="localhost"

# Local development login only.
# Ignored/refused in production. Seed upserts ordinary hashed users;
# login still goes through the normal Auth.js credentials path.
LOCAL_ADMIN_EMAIL=admin@local.aftercare.test
LOCAL_ADMIN_PASSWORD=LocalOnly123!
LOCAL_STAFF_EMAIL=staff@local.aftercare.test
LOCAL_STAFF_PASSWORD=LocalOnly123!
LOCAL_OPERATOR_EMAIL=operator@local.aftercare.test
LOCAL_OPERATOR_PASSWORD=LocalOnly123!

# Public marketing clinic enquiry. Server-only except the Turnstile site key.
# Production uses Resend + Cloudflare Turnstile. Do not commit real keys.
CONTACT_EMAIL_TO=hello@example.test
CONTACT_EMAIL_FROM="River Aftercare <website@example.test>"
CONTACT_MAILER=memory
# RESEND_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Auth transactional mail (password reset and operator-managed invitations).
# Not used by the marketing Contact form. Do not hardcode production mailboxes
# in application code.
AUTH_EMAIL_FROM="River Aftercare <accounts@example.test>"
AUTH_EMAIL_REPLY_TO=hello@example.test

# Optional absolute origin for sitemap.xml / robots.txt. When unset, derived
# from CARE_GUIDE_ROOT_DOMAIN (http for localhost, https otherwise).
# CARE_GUIDE_METADATA_BASE="http://localhost:3000"


# Supabase Realtime — optional in local dev. When these are unset the
# realtime publisher falls back to a no-op and the patient display
# subscriber becomes inert. Stage transitions still commit to the
# database and refreshing /display/[token] shows the latest persisted
# stage; only live updates are disabled.
#
# NEXT_PUBLIC_* vars are bundled into the patient client JavaScript.
# The service role key is server-only and must NEVER be prefixed with
# NEXT_PUBLIC_ — it authorizes the server-side broadcast publisher.

# Optional clinic logo object storage. Production driver is Cloudflare R2.
# Local `pnpm start` / Playwright use the filesystem driver so uploads survive
# the Next.js server-action vs route-handler bundle split. Vitest uses memory.
# Do not use filesystem or memory on Vercel. See docs/architecture/CLINIC-ASSETS.md
# and docs/launch/R2-PROVISIONING.md. Credentials are server-only — never prefix
# them with NEXT_PUBLIC_.
# CLINIC_ASSET_STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# CLINIC_ASSET_PUBLIC_ORIGIN=https://assets.example.test
# Optional jurisdiction or custom S3 API endpoint. When unset, derived as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_S3_ENDPOINT=
# Local / E2E (gitignored .data/clinic-assets by default):
# CLINIC_ASSET_STORAGE_DRIVER=filesystem
# CLINIC_ASSET_FILESYSTEM_ROOT=.data/clinic-assets
# Do not use CLINIC_ASSET_STORAGE_DRIVER=memory outside unit tests.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only Better Stack Error Tracking DSN (Sentry-compatible).
# Production: set on Vercel Production only to enable server exception tracking.
# Preview / development / test: omit intentionally — application telemetry stays off.
# Local `pnpm observability:test-error` may read this from ignored `.env`.
# That CLI is a one-shot operator verifier; it does not enable app telemetry.
# Never prefix with NEXT_PUBLIC_. Never commit a real DSN.
# BETTER_STACK_ERROR_DSN=https://examplePublicKey@o0.ingest.example.test/0
