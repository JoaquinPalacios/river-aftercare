# Matches the local PostgreSQL 18 container in compose.yaml (localhost:5432).
# Local `pnpm dev` / `pnpm db:*` use this database. Playwright does not.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/care_guide?schema=public"
# Dedicated Playwright database on the same PostgreSQL 18 server. `pnpm test:e2e`
# creates it if missing, migrates, and seeds it. It must not be the development DB.
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/care_guide_e2e?schema=public"
# Optional. Prisma CLI (migrate / seed / studio) uses DIRECT_URL when set,
# otherwise DATABASE_URL. Local Docker does not need a second URL.
# Production migrations use a local gitignored .env.neon-production file with
# DATABASE_URL (pooled) and DIRECT_URL (unpooled). Never put those secrets here.
# Canonical helpers: pnpm prod:db:status / pnpm prod:db:migrate --apply
# See docs/launch/PRODUCTION-MIGRATION.md.
# DIRECT_URL=
AUTH_SECRET="replace-with-a-long-random-string"

# Platform hostname root used by tenant routing. Local development:
# localhost → marketing homepage, app.localhost → staff, <slug>.localhost → tenant.
# Do not hard-code a commercial production domain here.
CARE_GUIDE_ROOT_DOMAIN="localhost"
# Optional marketing demo destinations. The three clinic pages are static, so
# Vercel must supply these before the production build. Only the exact HTTPS
# shared-demo guide URL enables that category's CTA. A trailing slash is fine.
# RIVER_AFTERCARE_DEMO_DENTAL_URL="https://demo.riveraftercare.com.au/extraction"
# RIVER_AFTERCARE_DEMO_PHYSIOTHERAPY_URL="https://demo.riveraftercare.com.au/home-exercise-plan"
# RIVER_AFTERCARE_DEMO_CHIROPRACTIC_URL="https://demo.riveraftercare.com.au/chiropractic-adjustment"
# Reserved until the Cosmetic & Aesthetic sample is published. Setting it does
# not enable a marketing CTA.
# RIVER_AFTERCARE_DEMO_COSMETIC_AESTHETIC_URL="https://demo.riveraftercare.com.au/superficial-chemical-peel"
# Deprecated. Still read when the matching RIVER_AFTERCARE_DEMO_* variable is
# unset or blank. Remove after the new variables are set in every environment.
# CARE_GUIDE_SHARED_DEMO_DENTAL_URL="https://demo.riveraftercare.com.au/extraction"
# CARE_GUIDE_PHYSIO_DEMO_PUBLIC_URL="https://demo.riveraftercare.com.au/home-exercise-plan"

# Local development login only.
# Ignored/refused in production. Seed upserts ordinary hashed users;
# login still goes through the normal Auth.js credentials path.
LOCAL_ADMIN_EMAIL=admin@local.aftercare.test
LOCAL_ADMIN_PASSWORD=LocalOnly123!
LOCAL_STAFF_EMAIL=staff@local.aftercare.test
LOCAL_STAFF_PASSWORD=LocalOnly123!
LOCAL_OPERATOR_EMAIL=operator@local.aftercare.test
LOCAL_OPERATOR_PASSWORD=LocalOnly123!

# Public marketing clinic enquiry. Server-only except the Turnstile site key.
# Production uses Resend + Cloudflare Turnstile. Do not commit real keys.
CONTACT_EMAIL_TO=hello@example.test
CONTACT_EMAIL_FROM="River Aftercare <website@example.test>"
CONTACT_MAILER=memory
# RESEND_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Auth transactional mail (password reset and operator-managed invitations).
# Not used by the marketing Contact form. Do not hardcode production mailboxes
# in application code.
AUTH_EMAIL_FROM="River Aftercare <accounts@example.test>"
AUTH_EMAIL_REPLY_TO=hello@example.test

# Vercel Cron bearer secret for GET /api/cron/billing-notices.
# Not required for local development or tests. Do not commit a real secret.
# CRON_SECRET=

# Optional absolute origin for sitemap.xml / robots.txt. When unset, derived
# from CARE_GUIDE_ROOT_DOMAIN (http for localhost, https otherwise).
# CARE_GUIDE_METADATA_BASE="http://localhost:3000"


# Optional clinic logo object storage. Production driver is Cloudflare R2.
# Local `pnpm start` / Playwright use the filesystem driver so uploads survive
# the Next.js server-action vs route-handler bundle split. Vitest uses memory.
# Do not use filesystem or memory on Vercel. See docs/architecture/CLINIC-ASSETS.md
# and docs/launch/R2-PROVISIONING.md. Credentials are server-only — never prefix
# them with NEXT_PUBLIC_.
# CLINIC_ASSET_STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# CLINIC_ASSET_PUBLIC_ORIGIN=https://assets.example.test
# Optional jurisdiction or custom S3 API endpoint. When unset, derived as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_S3_ENDPOINT=
# Local / E2E (gitignored .data/clinic-assets by default):
# CLINIC_ASSET_STORAGE_DRIVER=filesystem
# CLINIC_ASSET_FILESYSTEM_ROOT=.data/clinic-assets
# Do not use CLINIC_ASSET_STORAGE_DRIVER=memory outside unit tests.

# Application error monitoring (Sentry). Optional. The app works without these.
# A Sentry DSN is browser-visible configuration, not an application secret.
# Production: set NEXT_PUBLIC_SENTRY_DSN on Vercel Production to enable
# browser + server exception reporting. Preview may use the same variable later
# and is labelled environment=preview. Development, test, and local stay off
# even if a DSN is present.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional server-only DSN override. When unset, the server uses NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=
# Source-map upload is build-only and optional. Never prefix these with NEXT_PUBLIC_.
# Local `pnpm build` and tests must succeed without them.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Trusted-machine verifier (does not enable app telemetry):
#   pnpm observability:test-error

# Stripe Billing. Server-only. Never prefix with
# NEXT_PUBLIC_. There is no publishable Stripe key. Do not commit live or
# test secrets, Price IDs, or Portal configuration ids. Application startup
# does not require these; Checkout, the Customer Portal, and
# POST /api/stripe/webhook fail clearly when they are missing.
# VERCEL_ENV=production requires sk_live_ or rk_live_ plus live Price IDs,
# a live webhook signing secret, and a live Portal configuration.
# Preview and local accept sk_test_ or rk_test_ only. Never share credentials
# between environments. Public Group pricing stays custom.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_ESSENTIAL_MONTHLY_PRICE_ID=price_...
# STRIPE_ESSENTIAL_YEARLY_PRICE_ID=price_...
# STRIPE_PRACTICE_MONTHLY_PRICE_ID=price_...
# STRIPE_PRACTICE_YEARLY_PRICE_ID=price_...
# STRIPE_PRACTICE_ADDITIONAL_LOCATION_MONTHLY_PRICE_ID=price_...
# STRIPE_PRACTICE_ADDITIONAL_LOCATION_YEARLY_PRICE_ID=price_...
# STRIPE_GROUP_MONTHLY_PRICE_ID=price_...
# STRIPE_GROUP_YEARLY_PRICE_ID=price_...
# STRIPE_GROUP_ADDITIONAL_SITE_MONTHLY_PRICE_ID=price_...
# STRIPE_GROUP_ADDITIONAL_SITE_YEARLY_PRICE_ID=price_...
# Billing Portal configuration (bpc_...). Required before Manage billing can
# open. Use the TEST MODE configuration locally and on Preview, and the LIVE
# MODE configuration on Vercel Production. See docs/launch/STRIPE-SETUP.md.
# STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=bpc_...
